configuration_to_run = configuration_NS,  common_name = "lingcod",
survey = "NWFSC.Combo"
)
names(my_data)
my_data$family
my_data$formula
my_data$knots
my_data$share_range
my_data$anisotropy
list(my_data$spatiotemporal1, my_data$spatiotemporal2)
